# Copy this file to .env and add your own key.
# Get a free key at https://console.groq.com/keys

GROQ_API_KEY=your_groq_api_key_here

# Any Groq chat model works. Check what your key can access with:
#   python -c "from groq import Groq; import os; [print(m.id) for m in Groq(api_key=os.environ['GROQ_API_KEY']).models.list().data]"
#
# Good choices for this app:
#   openai/gpt-oss-120b     <- default, best at following the output format
#   openai/gpt-oss-20b      <- faster and cheaper
#   qwen/qwen3.8-27b
#
# Note: llama-3.3-70b-versatile is no longer served on all accounts, so it is not the default.
GROQ_MODEL=openai/gpt-oss-120b
